# ═══════════════════════════════════════════════════════════════
#  wasuite — configuración única (CRM + Agente WhatsApp + IA)
# ═══════════════════════════════════════════════════════════════
# Copia este archivo a .env y complétalo, o mejor genera los secretos
# automáticamente con:
#
#   node scripts/setup-env.mjs
#
# Las variables marcadas (REQUERIDO) impiden el arranque si faltan.

# ───────────────────────────────────────────────────────────────
# Dominios (producción con Traefik/Dokploy)
# ───────────────────────────────────────────────────────────────
# Ambos deben ser subdominios del MISMO dominio para que el login único funcione.
CRM_DOMAIN=crm.tudominio.com
WA_DOMAIN=wa.tudominio.com
# Dominio de la cookie de sesión, con punto inicial. Es lo que hace que un solo
# login valga para el CRM y el agente. En local déjalo vacío.
COOKIE_DOMAIN=.tudominio.com
# Red externa donde escucha Traefik (Dokploy la crea como dokploy-network).
TRAEFIK_NETWORK=dokploy-network

# ───────────────────────────────────────────────────────────────
# Acceso (REQUERIDO)
# ───────────────────────────────────────────────────────────────
# Credenciales del operador principal (rol admin). Con ellas entras al CRM y al
# agente; desde el dashboard puedes crear más usuarios con roles.
DASHBOARD_USER=admin
DASHBOARD_PASS=

# Secreto que firma la sesión compartida. DEBE ser idéntico en CRM y agente —
# este .env lo inyecta a ambos. Genera uno con: openssl rand -hex 32
SESSION_SECRET=

# Key interna con la que el agente crea leads en el CRM (header x-api-key).
INGEST_API_KEY=

# ───────────────────────────────────────────────────────────────
# Base de datos (REQUERIDO)
# ───────────────────────────────────────────────────────────────
POSTGRES_USER=crm
POSTGRES_PASSWORD=
POSTGRES_DB=crm

# ───────────────────────────────────────────────────────────────
# IA — OpenRouter (REQUERIDO para que el bot responda)
# ───────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://wa.tudominio.com
OPENROUTER_SITE_NAME=wasuite

# ───────────────────────────────────────────────────────────────
# Negocio
# ───────────────────────────────────────────────────────────────
BUSINESS_NAME=Mi Negocio
BUSINESS_DESCRIPTION=Descripción corta del negocio para el prompt del bot.
TIMEZONE=America/Guayaquil

# ───────────────────────────────────────────────────────────────
# Anti-ban / patrón humano (defaults sensatos, opcional ajustar)
# ───────────────────────────────────────────────────────────────
HUMAN_DELAY_MIN_MS=3000
HUMAN_DELAY_MAX_MS=12000
PER_CHAT_COOLDOWN_MS=4000
GLOBAL_MAX_PER_MIN=20
QUIET_HOURS_START=23
QUIET_HOURS_END=7
NEW_CONTACT_REQUIRES_HUMAN=false

# ───────────────────────────────────────────────────────────────
# Handoff automático a humano — enciéndelo cuando la KB esté cargada
# ───────────────────────────────────────────────────────────────
AUTO_HANDOFF=false
HANDOFF_ACK_TEXT=
HANDOFF_KEYWORDS=

# ───────────────────────────────────────────────────────────────
# Transcripción de notas de voz (opcional)
# ───────────────────────────────────────────────────────────────
# Para activarla: COMPOSE_PROFILES=whisper docker compose up -d
# y descomenta la URL del sidecar:
# WHISPER_URL=http://whisper:8000
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_LANGUAGE=es

# ───────────────────────────────────────────────────────────────
# Integraciones opcionales — vacías = apagadas
# ───────────────────────────────────────────────────────────────
# Media (imágenes/audio) en Cloudflare R2:
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Google Calendar (agendamiento de citas por el bot). Coloca el JSON del service
# account en ./credentials/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/google-service-account.json
GOOGLE_CALENDAR_ID=

# GoHighLevel (solo si el cliente usa GHL como CRM espejo):
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_SHARED_SECRET=
GHL_CONVERSATION_PROVIDER_ID=
GHL_REDIRECT_URI=
GHL_WEBHOOK_PUBLIC_KEY=

# Twenty-CRM externo (normalmente NO se usa: el CRM de la suite ya viene incluido):
CRM_URL=
CRM_API_TOKEN=
CRM_COUNTRY_CODE=593
