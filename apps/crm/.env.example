# ─────────────────────────────────────────────────────────────
# Base de datos — Postgres (REQUERIDO)
# ─────────────────────────────────────────────────────────────
# Local (docker-compose.dev.yml levanta este Postgres):
DATABASE_URL=postgres://crm:crm@localhost:5432/crm
# En producción (Dokploy) apunta al servicio 'db' del compose:
# DATABASE_URL=postgres://crm:CAMBIA_ESTA_CLAVE@db:5432/crm

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
# Puerto del servidor Next (Dokploy lo enruta por Traefik).
PORT=3000

# ─────────────────────────────────────────────────────────────
# Autenticación (login único de la suite)
# ─────────────────────────────────────────────────────────────
# El CRM NO tiene usuarios propios: el login se valida contra el agente
# (AGENT_API_URL) y ambos comparten la misma cookie de sesión. Los usuarios y
# contraseñas se gestionan en el agente (DASHBOARD_USER/PASS o data/users.json).
#
# Secreto para verificar la cookie de sesión (REQUERIDO — sin él, el CRM responde
# 503). Debe ser EL MISMO que SESSION_SECRET en el agente. Genera uno con:
#   openssl rand -hex 32
SESSION_SECRET=
# (Opcional) Dominio de la cookie, con punto inicial (ej: .cliente.com) para que
# la sesión valga en CRM y agente a la vez (subdominios del mismo dominio).
COOKIE_DOMAIN=

# ─────────────────────────────────────────────────────────────
# Ingesta desde el agente de WhatsApp
# ─────────────────────────────────────────────────────────────
# API key que el agente manda en el header x-api-key para crear leads.
# Vacía = ingesta deshabilitada. Genera una con: openssl rand -hex 24
INGEST_API_KEY=

# ─────────────────────────────────────────────────────────────
# Inbox unificado — conexión al agente de WhatsApp
# ─────────────────────────────────────────────────────────────
# El CRM muestra las conversaciones de WhatsApp pidiéndoselas al agente. En
# producción apunta al agente por la red interna de Docker.
# También valida el login (ver sección Autenticación). REQUERIDO.
# Ej local: http://localhost:3001   ·   Ej prod: http://agent:3000
AGENT_API_URL=
# (Opcional) API key (Bearer) del agente. Si está vacía, el CRM reenvía la cookie
# de sesión del usuario logueado — con SESSION_SECRET compartido no hace falta key.
AGENT_API_KEY=
# (Opcional) URL pública del dashboard del agente, para el enlace del QR desde el
# inbox cuando WhatsApp no está conectado.
AGENT_DASHBOARD_URL=

# ─────────────────────────────────────────────────────────────
# Postgres — credenciales para docker-compose (producción)
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=crm
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=crm
