# Server
PORT=3000
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme

# Secreto para firmar cookies de sesión (REQUERIDO — el agente no arranca sin él).
# Debe ser EL MISMO que en el CRM (apps/crm) para que el login sea único.
# Genera uno con: openssl rand -hex 32
SESSION_SECRET=

# (Opcional) Dominio de la cookie de sesión, con punto inicial (ej: .cliente.com).
# Hace que un login en el CRM también valga en el agente y viceversa cuando ambos
# viven en subdominios del mismo dominio (crm.cliente.com + wa.cliente.com).
COOKIE_DOMAIN=

# ─────────────────────────────────────────────────────────────
# CRM de la suite (apps/crm) — integración de leads
# ─────────────────────────────────────────────────────────────
# Cuando entra un mensaje, el agente avisa al CRM para crear el contacto y abrirle
# un lead en el pipeline. Vacío = integración apagada (el agente se comporta igual).
# Es independiente de GHL: puedes usar uno, otro, o los dos.
# Ej: http://crm:3000/api/ingest/whatsapp (red interna de Docker)
CRM_INGEST_URL=
# API key que espera el CRM (su INGEST_API_KEY). Se manda en el header x-api-key.
CRM_INGEST_KEY=
# Timeout de la llamada al CRM en ms (default 10000).
CRM_INGEST_TIMEOUT_MS=10000

# Infraestructura del despliegue (docker-compose.yml)
# WA_DOMAIN: host que enruta Traefik hacia el agente.
WA_DOMAIN=wa.tudominio.com
# WA_HOST_PORT: puerto publicado en el HOST. Solo hace falta si algo fuera de
# Docker consume el agente (ej. el nginx del LXC). En un VPS con Dokploy hay
# que moverlo — su panel ya escucha en el 3000 y el bind falla.
WA_HOST_PORT=3000

# Proxy de salida POR NÚMERO (IP dedicada por línea / anti-ban)
#   WA_PROXY_<NUMBERID>  proxy de ese número. numberId va en MAYÚSCULAS y con
#                        los no-alfanuméricos como '_' → 'ventas-01' es
#                        WA_PROXY_VENTAS_01
#   WA_PROXY             fallback global para los números sin proxy propio
# Formato: http://user:pass@host:puerto  ó  socks5://user:pass@host:puerto
# Vacío = el número sale directo por la IP del servidor.
# WA_PROXY_DEFAULT=
# WA_PROXY=

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-xxxx
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://wa.tudominio.com
OPENROUTER_SITE_NAME=wasuite

# Google Calendar
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/google-service-account.json
GOOGLE_CALENDAR_ID=primary
TIMEZONE=America/Guayaquil

# Negocio
BUSINESS_NAME=Mi Negocio
BUSINESS_DESCRIPTION=Descripción corta del negocio para el prompt del bot.

# Anti-ban / patrón humano para auto-respuestas de IA
# Delay aleatorio antes de enviar (ms). Total = max(LLM_latency, jitter(min,max))
HUMAN_DELAY_MIN_MS=3000
HUMAN_DELAY_MAX_MS=12000
# Cooldown mínimo entre respuestas IA al mismo chat (ms)
PER_CHAT_COOLDOWN_MS=4000
# Tope global de mensajes salientes IA por minuto (ventana deslizante)
GLOBAL_MAX_PER_MIN=20
# Horas en las que NO se auto-responde (zona TIMEZONE). Si start==end, deshabilitado.
QUIET_HOURS_START=23
QUIET_HOURS_END=7
# true = primer mensaje de un contacto nuevo escala a humano en vez de auto-responder
NEW_CONTACT_REQUIRES_HUMAN=false

# Handoff automático a humano — APAGADO por defecto
# true  = el bot escala solo cuando el cliente pide una persona o cuando la IA no
#         sabe responder. Al escalar, el chat pasa a modo HUMANO y la IA DEJA DE
#         RESPONDER ahí hasta que el operador lo devuelva a IA.
# false = (default) la IA nunca escala sola. El toggle manual por chat y el takeover
#         desde el dashboard siguen funcionando igual.
# Enciéndelo cuando tengas cargada la base de conocimiento: con la KB vacía el agente
# no puede responder casi nada y escalaría de más. El Laboratorio te dice si ya estás
# listo (corre con AUTO_HANDOFF apagado y encendido, y compara el score).
AUTO_HANDOFF=false
# Mensaje que se manda cuando el cliente pide hablar con una persona.
# Vacío = escala en silencio (el chat pasa a HUMANO pero no se le contesta nada).
HANDOFF_ACK_TEXT=Claro, en un momento te atiende un compañero del equipo 👍
# Frases extra (separadas por coma) que también disparan el handoff, además de la
# detección por defecto ("hablar con una persona", "un asesor", "un humano"...).
HANDOFF_KEYWORDS=

# GoHighLevel (app privada Marketplace)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_SHARED_SECRET=
GHL_CONVERSATION_PROVIDER_ID=
GHL_REDIRECT_URI=https://wa.tudominio.com/oauth/callback
# Public key PEM de la app del Marketplace (multilínea — usar comillas en docker compose).
# Cuando se configura, /webhooks/ghl/* rechaza POSTs sin x-wh-signature válida.
# Sin esto, los webhooks se aceptan en modo dev (con warning).
GHL_WEBHOOK_PUBLIC_KEY=

# Almacenamiento de media — Cloudflare R2 (opcional)
# Guarda imágenes/audios entrantes y sirve URLs públicas. Vacío = se deshabilita el subido.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Transcripción de voz — Whisper (opcional)
# WHISPER_URL apunta al sidecar faster-whisper-server (ver docker-compose.yml).
# Vacío = se deshabilita la transcripción de notas de voz.
WHISPER_URL=http://whisper:8000
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_LANGUAGE=es

# CRM Integration — Twenty-CRM (opcional)
# Setup completo para un cliente nuevo: ver TWENTY_CRM_SETUP.md
# CRM_URL es la URL donde corre Twenty-CRM.
# CRM_API_TOKEN: en Twenty, Settings > APIs > Create key.
# Vacío = se deshabilita la sincronización de contactos con CRM.
CRM_URL=
CRM_API_TOKEN=
# Código de país (sin +) del cliente — para casar números con/sin prefijo.
# Ecuador 593, Colombia 57, México 52, USA 1…
CRM_COUNTRY_CODE=593
# URL pública del dashboard del agente — se usa en el link "Abrir chat"
# que la sync escribe en cada contacto de Twenty.
PUBLIC_URL=https://wa.tudominio.com
# URL pública del CRM — la que resuelve el NAVEGADOR, para el iframe de /hub.
# Es distinta de CRM_URL: esa la usa el server para la sync y puede ser interna
# (ej. el nombre del contenedor). Vacía = /hub avisa que falta configurarla.
CRM_PUBLIC_URL=
